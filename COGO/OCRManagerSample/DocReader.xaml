<UserControl x:Class="OCRManagerSample.DocReaderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"   
             xmlns:ui="clr-namespace:OCRManagerSample"
             xmlns:extensions="clr-namespace:ArcGIS.Desktop.Extensions;assembly=ArcGIS.Desktop.Extensions"
             xmlns:controls="clr-namespace:ArcGIS.Desktop.Framework.Controls;assembly=ArcGIS.Desktop.Framework"                       
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="300"
             d:DataContext="{Binding Path=ui.DocReaderViewModel}">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <extensions:DesignOnlyResourceDictionary Source="pack://application:,,,/ArcGIS.Desktop.Framework;component\Themes\Default.xaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0" Margin="5,6,5,0" Text="Choose a document to OCR" Style="{DynamicResource Esri_RegularText}">
    </TextBlock>

    <Grid Grid.Row="1" Margin="5,6,5,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>

      <TextBlock  Grid.Column="0" Style="{DynamicResource Esri_TextBlockRegular}"
              Text="File Name:" VerticalAlignment="Center" />
      <TextBox  Grid.Column="1" Margin="5,0,0,0" MinHeight="25" IsReadOnly="true"
              Text="{Binding DocumentName}" 
              VerticalAlignment="Center" VerticalContentAlignment="Center"  />

      <Button Grid.Column="2"  Margin="5,0,0,0"   Width="20" Height="20"
             VerticalAlignment="Center"
             ToolTip="Browse..." 
             Command="{Binding BrowseDocumentCmd}"
             IsEnabled="true"
             BorderThickness="0">
        <Button.Content>
          <Image Source="{Binding MoveFolderImage}"/>
        </Button.Content>
      </Button>
    </Grid>

    <Button Grid.Row="2" Margin="5,6,5,0" Content="Clear" HorizontalAlignment="Right"  Style="{StaticResource Esri_SimpleButton}"
            Command="{Binding ClearCmd}"/>
    
    <TextBox Grid.Row="3" Margin="5,6" Text="{Binding Text}" IsReadOnly="True" ScrollViewer.VerticalScrollBarVisibility="Auto"/>
  </Grid>
</UserControl>