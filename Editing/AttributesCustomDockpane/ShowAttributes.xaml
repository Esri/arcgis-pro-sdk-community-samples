<UserControl x:Class="AttributesCustomDockpane.ShowAttributesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"   
             xmlns:ui="clr-namespace:AttributesCustomDockpane"
             xmlns:extensions="clr-namespace:ArcGIS.Desktop.Extensions;assembly=ArcGIS.Desktop.Extensions"
             xmlns:controls="clr-namespace:ArcGIS.Desktop.Framework.Controls;assembly=ArcGIS.Desktop.Framework"                       
             xmlns:editingControls="clr-namespace:ArcGIS.Desktop.Editing.Controls;assembly=ArcGIS.Desktop.Editing"    
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="300"
             d:DataContext="{Binding Path=ui.ShowAttributesViewModel}">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <extensions:DesignOnlyResourceDictionary Source="pack://application:,,,/ArcGIS.Desktop.Framework;component\Themes\Default.xaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="10*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="15*"/>
    </Grid.RowDefinitions>
    
    <DockPanel Grid.Row="0" LastChildFill="true" KeyboardNavigation.TabNavigation="Local" Height="30">
      <TextBlock Text="{Binding Heading}" Style="{DynamicResource Esri_TextBlockDockPaneHeader}">
        <TextBlock.ToolTip>
          <WrapPanel Orientation="Vertical" MaxWidth="300">
            <TextBlock Text="{Binding Heading}" TextWrapping="Wrap"/>
          </WrapPanel>
        </TextBlock.ToolTip>
      </TextBlock>
    </DockPanel>

    <editingControls:SelectionToolPickerControl Grid.Row="1" Map="{Binding Map}"/>

    <Grid Grid.Row="2"  Background="Transparent">

      <!--bind to Inspector to enable Copy Attributes / Paste Attributes on context menu-->
      <editingControls:SelectionControl Map="{Binding Map}" 
                                    Inspector="{Binding AttributeInspector}" />
    </Grid>

    <GridSplitter  Grid.Row="3" x:Name="TheSplitter"
                            Margin="-2,0,-2,0"
                            Width="Auto" Height="12"
                            ShowsPreview="False"
                            HorizontalAlignment="Stretch" VerticalAlignment="Center" />

    <Grid Grid.Row="4"
    Background="Transparent">
      <ContentPresenter x:Name="GridLandingPad" Content="{Binding InspectorView}"/>
    </Grid>
  </Grid>
</UserControl>