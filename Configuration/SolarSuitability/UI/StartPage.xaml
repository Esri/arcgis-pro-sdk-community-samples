<UserControl x:Class="SolarSuitability.UI.StartPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ui="clr-namespace:SolarSuitability.UI"
             xmlns:local="clr-namespace:SolarSuitability"
             xmlns:extensions="clr-namespace:ArcGIS.Desktop.Extensions;assembly=ArcGIS.Desktop.Extensions"
             mc:Ignorable="d"              
             d:DesignHeight="600" d:DesignWidth="600"
             d:DataContext="{Binding Path=ui.StartPageViewModel}">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <extensions:DesignOnlyResourceDictionary Source="pack://application:,,,/ArcGIS.Desktop.Framework;component\Themes\Default.xaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>
  <Grid Margin="10">
    <Grid.RowDefinitions>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    <Grid.Background>
      <ImageBrush ImageSource="../Images/background.png"
              AlignmentX="Center"
              AlignmentY="Center"
              TileMode="None"
              Opacity="1" />
    </Grid.Background>
    <Grid Grid.Row="0" Margin="50" HorizontalAlignment="Center" VerticalAlignment="Center" Background="{DynamicResource Esri_DialogClientAreaBackgroundBrush}">
      <Grid.Style>
        <Style TargetType="{x:Type Grid}">
          <Setter Property="Opacity" Value="0.8"></Setter>
        </Style>
      </Grid.Style>
      <Grid Grid.Column="1">
        <!-- OUTER GLOW FRAME -->
        <Border CornerRadius="14" Background="#C96A12" Padding="6">
          <!-- INNER FRAME -->
          <Border CornerRadius="12"
                Background="#E48A2A"
                BorderBrush="#FFD38A"
                BorderThickness="2"
                Padding="10">
            <StackPanel>
              <!-- TITLE -->
              <TextBlock Text="Select area of interest"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="#FFE7B0"
                           Margin="4,0,4,6"/>
              <!-- DROPDOWN + BUTTON BODY -->
              <Border CornerRadius="8"
				Background="#F2C078"
				BorderBrush="#B87333"
				BorderThickness="2"
				Padding="6">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>

                  <!-- ComboBox -->
                  <ComboBox x:Name="AreaCombo"
					  Grid.Column="0"
					  Background="Transparent"
					  BorderThickness="0"
					  FontSize="18"
					  FontWeight="SemiBold"
					  Foreground="#3A2408"
					  Padding="6"
					  MinWidth="260"
					  HorizontalContentAlignment="Stretch"
					  ItemsSource="{Binding ServiceAreas}"
					  SelectedValue="{Binding SelectedServiceArea}"/>

                  <!-- Open Button styled to match -->
                  <Border Grid.Column="1"
						Margin="6,0,0,0"
						CornerRadius="6"
						Background="#E48A2A"
						BorderBrush="#FFD38A"
						BorderThickness="2"
						Padding="4,2">
                    <Button Content="Open"
								Command="{Binding OpenProjectCommand}"
								Background="Transparent"
								BorderThickness="0"
								Foreground="#3A2408"
								FontSize="16"
								FontWeight="SemiBold"
								Padding="6,2"
								Cursor="Hand"/>
                  </Border>
                </Grid>
              </Border>
            </StackPanel>
          </Border>
        </Border>
      </Grid>
    </Grid>
  </Grid>
</UserControl>
