<UserControl x:Class="SolarSuitability.SolarSuitabilityView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"   
             xmlns:ui="clr-namespace:SolarSuitability"
             xmlns:extensions="clr-namespace:ArcGIS.Desktop.Extensions;assembly=ArcGIS.Desktop.Extensions"
             xmlns:controls="clr-namespace:ArcGIS.Desktop.Framework.Controls;assembly=ArcGIS.Desktop.Framework"  
						 xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="600" Background="#1f3b63"
             d:DataContext="{Binding Path=ui.SolarSuitabilityViewModel}">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <extensions:DesignOnlyResourceDictionary Source="pack://application:,,,/ArcGIS.Desktop.Framework;component\Themes\Default.xaml"/>
      </ResourceDictionary.MergedDictionaries>

      <Style x:Key="StepStyle" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Margin" Value="10,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="Black"/>
      </Style>
      <Style x:Key="StepCheckBoxStyle" TargetType="CheckBox">
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="CheckBox">
              <Grid Width="20" Height="20">
                <!-- Unchecked State - Pending Icon -->
                <Ellipse x:Name="Circle" Fill="#E67E22"/>
                <Path x:Name="CheckMark" 
											Data="M 5 10 L 8 13 L 15 7"
											Stroke="White" 
											StrokeThickness="4"
											StrokeStartLineCap="Round" 
											StrokeEndLineCap="Round"
											StrokeLineJoin="Round"
											Opacity="0.3"/>
              </Grid>
              <ControlTemplate.Triggers>
                <!-- Checked State - Completed Icon -->
                <Trigger Property="IsChecked" Value="True">
                  <Setter TargetName="Circle" Property="Fill" Value="#2E9E45"/>
                  <Setter TargetName="CheckMark" Property="Opacity" Value="1.0"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="ToggleButtonStyle" TargetType="{x:Type ToggleButton}">
        <!-- Default (Unchecked) State -->
        <Setter Property="Content" Value="ToDo" />
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Background" Value="#E67E22" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Height" Value="28"/>
        <Setter Property="Width" Value="80"/>
        <Setter Property="Padding" Value="8,3"/>
        <Setter Property="Margin" Value="5"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ToggleButton">
              <Border CornerRadius="6"
                Background="{TemplateBinding Background}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
        <Style.Triggers>
          <!-- Checked State -->
          <Trigger Property="IsChecked" Value="True">
            <Setter Property="Content" Value="Done" />
            <Setter Property="Background" Value="#2E9E45" />
          </Trigger>

          <!-- Indeterminate State (Optional, if IsThreeState is True) -->
          <Trigger Property="IsChecked" Value="{x:Null}">
            <Setter Property="Content" Value="working" />
            <Setter Property="Background" Value="Yellow" />
          </Trigger>
          <!-- 🔥 Disabled State (this is the key part) -->
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="#2E9E45"/>
                <Setter Property="BorderBrush" Value="#90A4AE"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="Cursor" Value="Arrow"/>
            </Trigger>
        </Style.Triggers>
      </Style>

      <Style x:Key="TriStepCheckBoxStyle" TargetType="CheckBox">
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="CheckBox">
              <Grid Width="20" Height="20">
                <!-- Unchecked State - Pending Icon -->
                <Ellipse x:Name="Circle" Fill="#E67E22"/>
                <Path x:Name="CheckMark" 
											Data="M 5 10 L 8 13 L 15 7"
											Stroke="White" 
											StrokeThickness="4"
											StrokeStartLineCap="Round" 
											StrokeEndLineCap="Round"
											StrokeLineJoin="Round"
											Opacity="0.3"/>
              </Grid>
              <ControlTemplate.Triggers>
                <!-- Checked State - Completed Icon -->
                <Trigger Property="IsChecked" Value="True">
                  <Setter TargetName="Circle" Property="Fill" Value="Yellow"/>
                  <Setter TargetName="CheckMark" Property="Opacity" Value="1.0"/>
                  <Setter TargetName="CheckMark" Property="Stroke" Value="Gray"/>
                </Trigger>
                <!-- Indeterminate -->
                <Trigger Property="IsChecked" Value="{x:Null}">
                  <Setter TargetName="Circle" Property="Fill" Value="#2E9E45"/>
                  <Setter TargetName="CheckMark" Property="Opacity" Value="1.0"/>
                  <Setter TargetName="CheckMark" Property="Stroke" Value="White"/>
                </Trigger>

              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="TriToggleButtonStyle" TargetType="{x:Type ToggleButton}">
        <!-- Default (Unchecked) State -->
        <Setter Property="Content" Value="ToDo" />
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Background" Value="#E67E22" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Height" Value="28"/>
        <Setter Property="Width" Value="80"/>
        <Setter Property="Padding" Value="8,3"/>
        <Setter Property="Margin" Value="5"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ToggleButton">
              <Border CornerRadius="6"
                Background="{TemplateBinding Background}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
        <Style.Triggers>
          <!-- Checked State -->
          <Trigger Property="IsChecked" Value="True">
            <Setter Property="Content" Value="working" />
            <Setter Property="Background" Value="Yellow" />
            <Setter Property="Foreground" Value="Black" />
          </Trigger>
          <!-- Indeterminate State (Optional, if IsThreeState is True) -->
          <Trigger Property="IsChecked" Value="{x:Null}">
            <Setter Property="Content" Value="Done" />
            <Setter Property="Background" Value="#2E9E45" />
            <Setter Property="Foreground" Value="White" />
          </Trigger>
        </Style.Triggers>
      </Style>
    </ResourceDictionary>
  </UserControl.Resources>
  <Grid>
    <Border Background="#E8E8E8"
                CornerRadius="12"
                Padding="5"
                Margin="5"            
                BorderBrush="Black"
                BorderThickness="2">

      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Header -->
            <RowDefinition Height="Auto"/>
            <!-- Separator -->
            <RowDefinition Height="Auto"/>
            <!-- Step 1 -->
            <RowDefinition Height="Auto"/>
            <!-- Step 2 -->
            <RowDefinition Height="Auto"/>
            <!-- Step 3 -->
            <RowDefinition Height="Auto"/>
            <!-- Step 4 -->
            <RowDefinition Height="Auto"/>
            <!-- Step 5 -->
            <RowDefinition Height="Auto"/>
            <!-- Step 6 -->
            <RowDefinition Height="Auto"/>
            <!-- Step 7 -->
            <RowDefinition Height="Auto"/>
            <!-- Separator -->
            <RowDefinition Height="Auto"/>
            <!-- Bottom Buttons -->
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>

          <!-- Header -->
          <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" FontSize="18" Foreground="Black">
            <Run Text="Solar Suitability Analysis for:"/>
            <LineBreak/>
            <Run Text="{Binding DistrictName}" FontWeight="Bold"/>
          </TextBlock>

          <!-- Separator -->
          <Separator Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,15"/>

          <!-- STEP 1 -->
          <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,10" Orientation="Horizontal" VerticalAlignment="Center">
            <CheckBox IsChecked="{Binding Step1Completed}" Style="{StaticResource StepCheckBoxStyle}"/>
            <TextBlock Text="Step 1:" Style="{StaticResource StepStyle}"/>
          </StackPanel>
                    <GroupBox Grid.Row="2" Grid.Column="1" Header="Create a solar radiation layer." Foreground="Black" BorderBrush="Black">
   
                        <StackPanel Margin="10,3" HorizontalAlignment="Right">
                            <TextBlock Text="Select analysis period:" Foreground="Black" Margin="0,0,0,5"/>
                                <StackPanel Orientation="Horizontal" Margin="0,5" HorizontalAlignment="Right">
                                    <TextBlock Text="From:" Foreground="Black"/>
                                    <DatePicker SelectedDate="{Binding FromDate}" Foreground="Black" DisplayDate="2026-03-01" Margin="10,0"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <TextBlock Text="To:" Foreground="Black"/>
                                    <DatePicker SelectedDate="{Binding ToDate}" Foreground="Black" DisplayDate="2026-09-01" Margin="10,0"/>
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>

          <ToggleButton Grid.Row="2" Grid.Column="2" IsThreeState="False" 
												IsChecked="{Binding Step1Checked}" Command="{Binding CmdStep1}"
									Style="{StaticResource ToggleButtonStyle}" />
        <!-- STEP 2 -->
        <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,10" Orientation="Horizontal" VerticalAlignment="Center">
            <CheckBox IsChecked="{Binding Step2Completed}" Style="{StaticResource StepCheckBoxStyle}"/>
            <TextBlock Text="Step 2:" Style="{StaticResource StepStyle}"/>
        </StackPanel>
        <TextBlock Grid.Row="3" Grid.Column="1"  Text="Create Slope and Aspect layers" Margin="10,0" VerticalAlignment="Center" Foreground="Black"/>
        <ToggleButton Grid.Row="3" Grid.Column="2" 
		IsThreeState="False"
		IsChecked="{Binding Step2Checked}"
		Command="{Binding CmdStep2}"
		Style="{StaticResource ToggleButtonStyle}" />
        <!-- STEP 3 -->
          <StackPanel Grid.Row="4" Grid.Column="0" Margin="0,10" Orientation="Horizontal" VerticalAlignment="Center">
            <CheckBox IsChecked="{Binding Step3Completed}" Style="{StaticResource StepCheckBoxStyle}"/>
            <TextBlock Text="Step 3:" Style="{StaticResource StepStyle}"/>
          </StackPanel>
          <GroupBox Grid.Row="4" Grid.Column="1" Header=" Configure Roof Suitability" Foreground="Black" BorderBrush="Black">
            <StackPanel Margin="10,3" HorizontalAlignment="Right">
              <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="5" HorizontalAlignment="Right">
                <TextBlock Text="Solar radiation [kWh/m²]:"/>
                <xctk:DecimalUpDown Value="{Binding Radiation}" Maximum="1600" Increment="100" FormatString="F0"
											MinWidth="50" Margin="10,0" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Margin="5" HorizontalAlignment="Right">
                <TextBlock Text="Max Roof Angle:" Foreground="Black"/>
                <xctk:DecimalUpDown Minimum="0.0" Value="{Binding MaxRoofAngle}" Maximum="45.0" Increment="0.5" FormatString="F1"
																		MinWidth="50" Margin="10,0"/>
              </StackPanel>
              <StackPanel Orientation="Horizontal" Margin="5" HorizontalAlignment="Right">
                <CheckBox IsChecked="True" Margin="10,0">Remove Roofs facing North</CheckBox>
              </StackPanel>
            </StackPanel>
          </GroupBox>
          <ToggleButton Grid.Row="4" Grid.Column="2" IsThreeState="False"
												IsChecked="{Binding Step3Checked}"
									Style="{StaticResource ToggleButtonStyle}" Command="{Binding CmdStep3}" />



          <!-- STEP 4 -->
          <StackPanel Grid.Row="5" Grid.Column="0" Margin="0,10" Orientation="Horizontal" VerticalAlignment="Center">
            <CheckBox IsChecked="{Binding Step4Completed}" Style="{StaticResource StepCheckBoxStyle}"/>
            <TextBlock Text="Step 4:" Style="{StaticResource StepStyle}"/>
          </StackPanel>
          <TextBlock Grid.Row="5" Grid.Column="1"  Text="Calculate power per building" Margin="10,0" VerticalAlignment="Center" Foreground="Black"/>
                    <ToggleButton Grid.Row="5" Grid.Column="2" Command="{Binding CmdStep4}"
												IsThreeState="False"
												IsChecked="{Binding Step4Checked}"
									Style="{StaticResource ToggleButtonStyle}" />
          <!-- STEP 5 -->
          <StackPanel Grid.Row="6" Grid.Column="0" Margin="0,10" Orientation="Horizontal" VerticalAlignment="Center">
            <CheckBox IsChecked="{Binding Step5Completed}" Style="{StaticResource StepCheckBoxStyle}"/>
            <TextBlock Text="Step 5:" Style="{StaticResource StepStyle}"/>
          </StackPanel>
          <GroupBox Grid.Row="6" Grid.Column="1" Header=" Apply Symbology" Foreground="Black" BorderBrush="Black">
            <ListBox ItemsSource="{Binding LegendItems}" Margin="5" >
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <StackPanel Orientation="Horizontal">
                    <Rectangle Width="20" Height="20" Fill="{Binding Color}" Stroke="Black" Margin="0,0,10,0"/>
                    <TextBlock Text="{Binding Label}" VerticalAlignment="Center"/>
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </GroupBox>
                    <ToggleButton Grid.Row="6" Grid.Column="2" Command="{Binding CmdStep5}"
												IsThreeState="False"
												IsChecked="{Binding Step5Checked}"
									Style="{StaticResource ToggleButtonStyle}" />

          <!-- STEP 6 -->
          <StackPanel Grid.Row="7" Grid.Column="0" Margin="0,10" Orientation="Horizontal" VerticalAlignment="Center">
            <CheckBox IsChecked="{Binding Step6Completed}" Style="{StaticResource StepCheckBoxStyle}"/>
            <TextBlock Text="Step 6:" Style="{StaticResource StepStyle}"/>
          </StackPanel>
          <StackPanel Grid.Row="7" Grid.Column="1" Orientation="Horizontal">
            <TextBlock Grid.Row="0" Margin="10,0" Foreground="Black" VerticalAlignment="Center" >Identify suitable building</TextBlock>
            <Button Content="Identify" Command="{Binding ShowReportCommand}" Style="{DynamicResource Esri_Button}" Height="25"/>
          </StackPanel>
          <ToggleButton Grid.Row="7" Grid.Column="2" IsThreeState="False"
												IsChecked="{Binding Step6Checked}"
									Style="{StaticResource ToggleButtonStyle}" />

          <!-- STEP 7 -->
          <StackPanel Grid.Row="8" Grid.Column="0" Margin="0,10" Orientation="Horizontal" VerticalAlignment="Center"/>


                    <!-- Separator -->
          <Separator Grid.Row="9" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,20"/>

          <!-- Bottom Buttons -->
          <StackPanel Grid.Row="10" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Content="Cancel" Command="{Binding CancelCommand}" Width="110" Margin="5" Style="{DynamicResource Esri_Button}"/>
          </StackPanel>
        </Grid>
      </ScrollViewer>
    </Border>
  </Grid>
</UserControl>