{
    "version":  "2.0.0",
    "tasks":  [
                  {
                      "label":  "build-debug",
                      "type":  "process",
                      "command":  "dotnet",
                      "args":  [
                                   "build",
                                   "ContextualRibbonTab.csproj",
                                   "-c",
                                   "Debug",
                                   "/property:GenerateFullPaths=true",
                                   "/consoleloggerparameters:NoSummary"
                               ],
                      "options":  {
                                      "cwd":  "${workspaceFolder}"
                                  },
                      "group":  {
                                    "kind":  "build",
                                    "isDefault":  false
                                },
                      "problemMatcher":  "$msCompile"
                  },
                  {
                      "label":  "build-release",
                      "type":  "process",
                      "command":  "dotnet",
                      "args":  [
                                   "build",
                                   "ContextualRibbonTab.csproj",
                                   "-c",
                                   "Release",
                                   "/property:GenerateFullPaths=true",
                                   "/consoleloggerparameters:NoSummary"
                               ],
                      "options":  {
                                      "cwd":  "${workspaceFolder}"
                                  },
                      "group":  {
                                    "kind":  "build",
                                    "isDefault":  true
                                },
                      "problemMatcher":  "$msCompile"
                  }
              ]
}