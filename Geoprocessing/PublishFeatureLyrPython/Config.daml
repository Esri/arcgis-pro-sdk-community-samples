  <modules>
    <insertModule id="PublishFeatureLyrPython_Module" className="Module1" autoLoad="false" caption="Module1">
      <!-- uncomment to have the control hosted on a separate tab-->
      <tabs>
        <!--<tab id="PublishFeatureLyrPython_Tab1" caption="New Tab">
          <group refID="PublishFeatureLyrPython_Group1"/>
        </tab>-->
      </tabs>
      <groups>
        <!-- comment this out if you have no controls on the Addin tab to avoid
              an empty group-->
        <group id="PublishFeatureLyrPython_Group1" caption="Group 1" appearsOnAddInTab="true">
          <!-- host controls within groups -->
          <button refID="PublishFeatureLyrPython_RunMyPython" size="large" />
          <button refID="PublishFeatureLyrPython_RunGPToolInspector" size="large" />
        </group>
      </groups>
      <controls>
        <!-- add your controls here -->
        <button id="PublishFeatureLyrPython_RunMyPython" caption="Run My Python" className="RunMyPython" loadOnClick="true" smallImage="GenericButtonBlue16" largeImage="GenericButtonBlue32">
          <tooltip heading="Tooltip Heading">Tooltip text<disabledText /></tooltip>
        </button>
        <button id="PublishFeatureLyrPython_RunGPToolInspector" caption="Run GPTool Inspector"
                className="RunGPToolInspector" loadOnClick="true" smallImage="GenericButtonBlue16" largeImage="GenericButtonBlue32">
          <tooltip heading="Tooltip Heading">Tooltip text<disabledText /></tooltip>
        </button>
      </controls>
    </insertModule>
  </modules>
